<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.4.2</Version>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sprocket</GameDir>
    <PathMap>$(MSBuildThisFileDirectory)=/hydropneumatic/</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SprocketKeybinds"><HintPath>$(GameDir)\BepInEx\plugins\SprocketKeybinds\SprocketKeybinds.dll</HintPath><Private>false</Private></Reference>
    <Compile Remove="tests\**\*.cs" />
    <Reference Include="$(GameDir)\BepInEx\core\*.dll" Exclude="$(GameDir)\BepInEx\core\TerraFX*.dll;$(GameDir)\BepInEx\core\dobby.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)\BepInEx\interop\*.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>

